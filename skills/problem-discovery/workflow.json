{
 "workflow": "problem-discovery",
 "title": "Problem discovery",
 "summary": "Read a pile of raw material (interviews, call transcripts, tickets, usage data), pull out the problems people actually have, show the evidence for and against each, and help the person choose which are worth solving.",
 "inputs": [
  {
   "name": "sources",
   "kind": "folder",
   "hint": "A folder or list of files: interview notes, transcripts, ticket exports, data tables."
  }
 ],
 "dataset": {
  "path": "data/{slug}-problems.json",
  "adds": [
   "source",
   "problem"
  ],
  "status_field": "status"
 },
 "steps": [
  "Read the sources",
  "Find candidate problems",
  "Weigh the evidence",
  "Choose what is worth solving",
  "Write the problem brief"
 ],
 "progress": {
  "records": {
   "type": "problem"
  },
  "field": "status",
  "done": [
   "reviewed",
   "parked"
  ],
  "noun": "problems",
  "label": "sorted"
 },
 "schemas": "schemas/records.json",
 "views": {
  "problems": "views/problems.json",
  "sources": "views/sources.json",
  "focus": "views/focus.json",
  "summary": "views/summary.json"
 },
 "work_products": [
  {
   "name": "Problems",
   "view": "problems",
   "out": "artifacts/{slug}-problems.html"
  },
  {
   "name": "Sources",
   "view": "sources",
   "out": "artifacts/{slug}-sources.html"
  },
  {
   "name": "Problem brief",
   "out": "artifacts/{slug}-problem-brief.md"
  }
 ],
 "participants": [
  "mara-okafor",
  "support-insights"
 ],
 "launchers": [
  {
   "label": "Find the problems in these",
   "on": "folder",
   "prompt": "Find the problems worth solving in {path}."
  }
 ]
}
