{
 "scenario": "requirements-to-dependencies",
 "title": "Requirements to dependencies",
 "summary": "For each requirement, a sub-agent finds the platform capabilities that could meet it. The product manager starts, answers and reviews twenty explorations on one board.",
 "inputs": [
  { "name": "dataset", "kind": "dataset", "hint": "A requirements dataset from prd-to-requirements" },
  { "name": "platform map", "kind": "markdown", "hint": "What the platform offers. Looks in context/ first." }
 ],
 "dataset": { "path": "data/{slug}.json", "adds": ["dependency", "option"], "status_field": "explore_status" },
 "steps": ["Set up the board", "Explore each requirement", "Your review", "Summary"],
 "progress": {"records": {"type": "requirement"}, "field": "explore_status", "done": ["reviewed"], "noun": "requirements", "label": "reviewed"},
 "schemas": "schemas/records.json",
 "views": { "board": "views/board.json", "summary": "views/summary.json", "review": "views/review-card.json" },
 "work_products": [ { "name": "Dependency board", "view": "board", "out": "artifacts/{slug}-dependencies.html" } ],
 "fixtures": { "dataset": "fixtures/allowances.json", "platform": "fixtures/platform-map.md" },
 "script": "script.md",
 "launchers": [ { "label": "Map dependencies", "on": "dataset", "prompt": "Map the platform dependencies for the requirements in {path}." } ],
 "needs": ["prd-to-requirements"],
 "next": []
}
