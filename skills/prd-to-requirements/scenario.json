{
 "scenario": "prd-to-requirements",
 "title": "PRD to requirements",
 "summary": "Turn a requirements document into a catalog of testable requirements the product manager can review, edit and lock.",
 "inputs": [ { "name": "document", "kind": "markdown", "hint": "A PRD or similar. Looks in context/ first." } ],
 "dataset": { "path": "data/{slug}.json", "adds": ["capability", "requirement"], "status_field": "status" },
 "schemas": "schemas/records.json",
 "views": { "scope": "views/scope-form.json", "catalog": "views/catalog.json", "summary": "views/summary.json" },
 "work_products": [ { "name": "Requirements catalog", "view": "catalog", "out": "artifacts/{slug}-requirements.html" } ],
 "fixtures": { "dataset": "fixtures/allowances.json", "document": "fixtures/allowances-prd.md" },
 "script": "script.json",
 "launchers": [ { "label": "Catalog requirements", "on": "markdown", "prompt": "Catalog the requirements in {path}." } ],
 "next": ["requirements-to-dependencies"]
}
